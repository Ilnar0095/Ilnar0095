# ────────────────────────────────────────────────────────────────
#  COOKRATE Bot — скопируйте в bot/.env и заполните
#  telegram-токен: @BotFather → /newbot
# ────────────────────────────────────────────────────────────────

# ОБЯЗАТЕЛЬНО
TELEGRAM_BOT_TOKEN=123456:AAA...
# ваш числовой id: напишите боту /id
TELEGRAM_ADMIN_ID=000000000
# пускать только свои чаты (через запятую); пусто = только админ
TELEGRAM_ALLOWED_CHATS=

# РЕПОЗИТОРИЙ
# путь к клону Ilnar0095/Ilnar0095; внутри бот читает dzen/ и пишет в dzen/next/
COOKRATE_REPO=/app/repo

# ТЕКСТЫ. Без ключей бот работает как «каркас + линтер»: генерирует структуру
# статьи по ДНК канала и проверяет её правилами dzen/tools/cookrate.py.
# С ключом — пишет готовый текст.
LLM_FORMAT=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Anthropic: LLM_FORMAT=anthropic, BASE_URL=https://api.anthropic.com/v1, MODEL=claude-sonnet-4-5
# OpenRouter (одним ключом много моделей): BASE_URL=https://openrouter.ai/api/v1, MODEL=openai/gpt-4o-mini

# ФОТОИЛЛЮСТРАЦИИ. none = бот сам соберёт обложку из референса Анжелы + подпись (ffmpeg)
IMAGE_PROVIDER=none
IMAGE_SIZE=1536x1024
# OpenAI (gpt-image-1): IMAGE_PROVIDER=openai, ключ берётся из LLM_API_KEY
# Replicate: IMAGE_PROVIDER=replicate + REPLICATE_API_TOKEN + IMAGE_MODEL
REPLICATE_API_TOKEN=
IMAGE_MODEL=black-forest-labs/flux-1.1-pro
# Replicate требует явную версию модели для некоторых эндпоинтов:
# IMAGE_MODEL=stability-ai/sdxl:39380786e271332701aaee73be5f5fa92fdbd4f1a8b505bf0c7e3068593e9e0f

# ВИДЕО (ролики-превью 16:9 и вертикальные тизеры)
VIDEO_PROVIDER=none
VIDEO_MODEL=stability-ai/stable-video-diffusion:3f0457e4619cabac8d3bbed3ae81a6f0fa2f63a59c14239eb76cba9603813f89
VIDEO_SECONDS=4

# ОЗВУЧКА
TTS_PROVIDER=edge
TTS_VOICE=ru-RU-SvetlanaNeural
# варианты: ru-RU-DmitryNeural (м), ru-RU-SvetlanaNeural (ж), ru-Tatar-SelimNeural

# ОБЛОЖКИ БЕЗ ИИ-ГЕНЕРАЦИИ: референс Анжелы + подпись сверху
COVER_SOURCE=dzen/assets/angela-01-kurica-s-apelsinom.png
COVER_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
